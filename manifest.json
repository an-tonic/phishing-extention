{
  "manifest_version": 3,
  "name": "Phishing Link Detector",
  "version": "1.0",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "type": "module"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["model.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": []
}
