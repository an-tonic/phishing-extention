{
  "manifest_version": 3,
  "name": "Phishing Link Detector",
  "version": "1.0",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "permissions": ["tabs", "storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "type": "module"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["model.js", "variables.js", "explanation-popup.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
